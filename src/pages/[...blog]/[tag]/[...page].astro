---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, getStaticPathsBlogTag } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag, locale = 'en' } = Astro.props as Props & { locale: 'zh' | 'en' };
const isChinese = locale === 'zh';

const currentPage = page.currentPage ?? 1;

const metadata = {
  title: isChinese
    ? `标签：${tag.title}${currentPage > 1 ? ` — 第 ${currentPage} 页` : ''}`
    : `Tag: ${tag.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata} {locale}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle={isChinese ? '按标签浏览' : 'Browse by tag'}>{tag.title}</Headline>
    <BlogList posts={page.data} {locale} />
    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      prevText={isChinese ? '较新文章' : 'Newer posts'}
      nextText={isChinese ? '较早文章' : 'Older posts'}
    />
  </section>
</Layout>
