---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
  locale?: 'zh' | 'en';
}

const { text, url, class: className = 'inline-block', locale = 'en' } = Astro.props;
---

<div class={className}>
  <span class="align-super font-bold text-slate-500 dark:text-slate-400">{locale === 'zh' ? '分享：' : 'Share:'}</span>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title={locale === 'zh' ? '分享到 X' : 'Share on X'}
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-x"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title={locale === 'zh' ? '分享到 Facebook' : 'Share on Facebook'}
    data-aw-social-share="facebook"
    data-aw-url={url}
    ><Icon
      name="tabler:brand-facebook"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title={locale === 'zh' ? '分享到微博' : 'Share on Weibo'}
    data-aw-social-share="weibo"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-weibo"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title={locale === 'zh' ? '分享到微信' : 'Share on WeChat'}
    data-aw-social-share="wechat"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-wechat"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
  <button
    class="ml-2 rtl:ml-0 rtl:mr-2"
    title={locale === 'zh' ? '分享到 QQ' : 'Share on QQ'}
    data-aw-social-share="qq"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon
      name="tabler:brand-qq"
      class="w-6 h-6 text-gray-400 dark:text-slate-500 hover:text-black dark:hover:text-slate-300"
    />
  </button>
</div>
