---
const mosaicPixels = Array.from({ length: 112 }, (_, index) => {
  const columns = 14;
  const rows = 8;
  const column = index % columns;
  const row = Math.floor(index / columns);

  return {
    x: ((column + 0.5) / columns) * 100,
    y: ((row + 0.5) / rows) * 100,
    delay: -((index * 37) % 71) / 10,
    scale: 0.72 + ((index * 17) % 9) / 20,
    minScale: (0.72 + ((index * 17) % 9) / 20) * 0.76,
    fadeScale: (0.72 + ((index * 17) % 9) / 20) * 0.88,
  };
});
---

<future-particles
  class="pointer-events-none absolute inset-0 block overflow-hidden select-none"
  data-surface="dark"
  aria-hidden="true"
>
  <div class="mosaic-field" aria-hidden="true">
    {
      mosaicPixels.map((pixel) => (
        <span
          class="mosaic-pixel"
          style={`--pixel-x:${pixel.x}%;--pixel-y:${pixel.y}%;--pixel-delay:${pixel.delay}s;--pixel-scale:${pixel.scale};--pixel-min-scale:${pixel.minScale};--pixel-fade-scale:${pixel.fadeScale}`}
        />
      ))
    }
  </div>
  <canvas class="block h-full w-full" aria-hidden="true"></canvas>
</future-particles>

<script>
  type NodeKind = 'orchestrator' | 'agent' | 'tool';

  type Palette = {
    core: string;
    agent: string;
    tool: string;
    line: string;
    particle: string;
    surface: string;
    glow: number;
  };

  type SceneNode = {
    kind: NodeKind;
    x: number;
    y: number;
    size: number;
    phase: number;
  };

  type TaskPath = {
    from: number;
    to: number;
    bend: number;
    phase: number;
    speed: number;
  };

  type Particle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    alpha: number;
    phase: number;
  };

  type Point = {
    x: number;
    y: number;
  };

  const TAU = Math.PI * 2;

  const LIGHT_PALETTE: Palette = {
    core: '37, 99, 235',
    agent: '79, 70, 229',
    tool: '13, 148, 136',
    line: '99, 102, 241',
    particle: '14, 116, 144',
    surface: '255, 255, 255',
    glow: 0.52,
  };

  const DARK_PALETTE: Palette = {
    core: '104, 164, 232',
    agent: '126, 151, 211',
    tool: '231, 211, 166',
    line: '112, 158, 218',
    particle: '218, 230, 248',
    surface: '8, 15, 35',
    glow: 0.86,
  };

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  const seededRandom = (seed: number) => {
    let state = seed >>> 0;

    return () => {
      state += 0x6d2b79f5;
      let value = state;
      value = Math.imul(value ^ (value >>> 15), value | 1);
      value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
      return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
    };
  };

  class FutureParticles extends HTMLElement {
    private canvas: HTMLCanvasElement | null = null;
    private context: CanvasRenderingContext2D | null = null;
    private width = 0;
    private height = 0;
    private pixelRatio = 1;
    private animationFrame = 0;
    private resizeFrame = 0;
    private lastFrame = 0;
    private elapsed = 0;
    private initialized = false;
    private inView = true;
    private pageVisible = !document.hidden;
    private swapping = false;
    private reducedMotion = false;
    private compact = false;
    private palette = LIGHT_PALETTE;
    private nodes: SceneNode[] = [];
    private paths: TaskPath[] = [];
    private particles: Particle[] = [];
    private abortController: AbortController | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private intersectionObserver: IntersectionObserver | null = null;
    private themeObserver: MutationObserver | null = null;
    private motionQuery: MediaQueryList | null = null;
    private compactQuery: MediaQueryList | null = null;
    private pointer = {
      x: 0,
      y: 0,
      targetX: 0,
      targetY: 0,
      active: false,
      lastSeen: 0,
    };

    connectedCallback() {
      if (this.initialized) return;

      this.canvas = this.querySelector('canvas');
      this.context = this.canvas?.getContext('2d') ?? null;
      if (!this.canvas || !this.context) return;

      this.initialized = true;
      this.abortController = new AbortController();
      const { signal } = this.abortController;

      this.motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.compactQuery = window.matchMedia('(max-width: 767px), (pointer: coarse)');
      this.reducedMotion = this.motionQuery.matches;
      this.compact = this.compactQuery.matches;
      this.updatePalette();

      this.motionQuery.addEventListener('change', this.handleMotionPreference, { signal });
      this.compactQuery.addEventListener('change', this.handleCompactPreference, { signal });
      window.addEventListener('pointermove', this.handlePointerMove, { passive: true, signal });
      window.addEventListener('blur', this.handlePointerLeave, { signal });
      document.addEventListener('pointerleave', this.handlePointerLeave, { signal });
      document.addEventListener('visibilitychange', this.handleVisibilityChange, { signal });
      document.addEventListener('astro:before-swap', this.handleBeforeSwap, { signal });
      document.addEventListener('astro:page-load', this.handlePageLoad, { signal });

      this.resizeObserver = new ResizeObserver(this.queueResize);
      this.resizeObserver.observe(this);

      this.intersectionObserver = new IntersectionObserver(this.handleIntersection, {
        rootMargin: '80px 0px',
        threshold: 0.01,
      });
      this.intersectionObserver.observe(this);

      this.themeObserver = new MutationObserver(this.handleThemeChange);
      this.themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

      this.resizeCanvas();
      this.syncAnimation();
    }

    disconnectedCallback() {
      this.destroy();
    }

    private readonly handleMotionPreference = (event: MediaQueryListEvent) => {
      this.reducedMotion = event.matches;
      this.syncAnimation();
    };

    private readonly handleCompactPreference = (event: MediaQueryListEvent) => {
      this.compact = event.matches;
      this.resizeCanvas(true);
      this.syncAnimation();
    };

    private readonly handlePointerMove = (event: PointerEvent) => {
      if (this.compact || event.pointerType === 'touch') return;

      const bounds = this.getBoundingClientRect();
      const inside =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom;

      if (!inside) {
        this.pointer.active = false;
        return;
      }

      this.pointer.targetX = event.clientX - bounds.left;
      this.pointer.targetY = event.clientY - bounds.top;
      this.style.setProperty('--pointer-x', `${this.pointer.targetX}px`);
      this.style.setProperty('--pointer-y', `${this.pointer.targetY}px`);
      this.dataset.pointer = 'active';
      if (!this.pointer.active) {
        this.pointer.x = this.pointer.targetX;
        this.pointer.y = this.pointer.targetY;
      }
      this.pointer.active = true;
      this.pointer.lastSeen = performance.now();
    };

    private readonly handlePointerLeave = () => {
      this.pointer.active = false;
      delete this.dataset.pointer;
    };

    private readonly handleVisibilityChange = () => {
      this.pageVisible = !document.hidden;
      this.syncAnimation();
    };

    private readonly handleBeforeSwap = () => {
      this.swapping = true;
      this.stopAnimation();
    };

    private readonly handlePageLoad = () => {
      if (!this.isConnected) return;

      this.swapping = false;
      this.resizeCanvas();
      this.syncAnimation();
    };

    private readonly handleIntersection = (entries: IntersectionObserverEntry[]) => {
      const entry = entries.at(-1);
      if (!entry) return;

      this.inView = entry.isIntersecting;
      this.syncAnimation();
    };

    private readonly handleThemeChange = () => {
      this.updatePalette();
      this.drawScene(this.elapsed);
    };

    private readonly queueResize = () => {
      if (this.resizeFrame) return;

      this.resizeFrame = window.requestAnimationFrame(() => {
        this.resizeFrame = 0;
        this.resizeCanvas();
        this.syncAnimation();
      });
    };

    private updatePalette() {
      const usesDarkSurface = this.dataset.surface === 'dark' || document.documentElement.classList.contains('dark');
      this.palette = usesDarkSurface ? DARK_PALETTE : LIGHT_PALETTE;
    }

    private resizeCanvas(forceScene = false) {
      if (!this.canvas || !this.context) return;

      const bounds = this.getBoundingClientRect();
      const nextWidth = Math.round(bounds.width);
      const nextHeight = Math.round(bounds.height);
      if (nextWidth < 2 || nextHeight < 2) return;

      const nextCompact = this.compactQuery?.matches || nextWidth < 640;
      const nextRatio = Math.min(window.devicePixelRatio || 1, nextCompact ? 1.25 : 1.8);
      const dimensionsChanged =
        nextWidth !== this.width || nextHeight !== this.height || Math.abs(nextRatio - this.pixelRatio) > 0.01;

      this.compact = Boolean(nextCompact);
      if (!dimensionsChanged && !forceScene) return;

      this.width = nextWidth;
      this.height = nextHeight;
      this.pixelRatio = nextRatio;
      this.canvas.width = Math.round(this.width * this.pixelRatio);
      this.canvas.height = Math.round(this.height * this.pixelRatio);
      this.context.setTransform(this.pixelRatio, 0, 0, this.pixelRatio, 0, 0);
      this.context.lineCap = 'round';
      this.context.lineJoin = 'round';
      this.createScene();
      this.drawScene(this.elapsed);
    }

    private createScene() {
      const scale = clamp(Math.min(this.width / 1180, this.height / 650), 0.68, 1.2);
      const layouts: Array<[NodeKind, number, number, number]> = this.compact
        ? [
            ['orchestrator', 0.72, 0.34, 18],
            ['agent', 0.24, 0.19, 10],
            ['agent', 0.2, 0.66, 11],
            ['agent', 0.77, 0.72, 10],
            ['tool', 0.48, 0.52, 8],
            ['tool', 0.46, 0.82, 7],
          ]
        : [
            ['orchestrator', 0.75, 0.37, 20],
            ['agent', 0.56, 0.16, 11],
            ['agent', 0.91, 0.17, 10],
            ['agent', 0.51, 0.49, 12],
            ['agent', 0.91, 0.49, 11],
            ['agent', 0.66, 0.71, 10],
            ['agent', 0.9, 0.76, 9],
            ['agent', 0.21, 0.28, 10],
            ['agent', 0.25, 0.73, 9],
            ['tool', 0.62, 0.31, 8],
            ['tool', 0.8, 0.61, 8],
            ['tool', 0.39, 0.68, 7],
          ];

      this.nodes = layouts.map(([kind, x, y, size], index) => ({
        kind,
        x: x * this.width,
        y: y * this.height,
        size: size * scale,
        phase: index * 1.137 + 0.4,
      }));

      const pathLayouts: Array<[number, number, number, number]> = this.compact
        ? [
            [0, 1, -0.13, 0.12],
            [0, 2, 0.17, 0.48],
            [0, 3, -0.14, 0.78],
            [2, 4, -0.18, 0.34],
            [3, 5, 0.21, 0.66],
          ]
        : [
            [0, 1, -0.13, 0.08],
            [0, 2, 0.12, 0.41],
            [0, 3, 0.08, 0.72],
            [0, 4, -0.1, 0.24],
            [0, 5, 0.15, 0.56],
            [0, 6, -0.14, 0.9],
            [3, 7, -0.11, 0.37],
            [3, 8, 0.18, 0.68],
            [1, 9, 0.2, 0.16],
            [4, 10, -0.16, 0.52],
            [5, 11, 0.14, 0.82],
          ];

      this.paths = pathLayouts.map(([from, to, bend, phase], index) => ({
        from,
        to,
        bend,
        phase,
        speed: 0.055 + (index % 4) * 0.011,
      }));

      const random = seededRandom(0x78646167 ^ this.width ^ (this.height << 8));
      const particleCount = this.compact ? 22 : clamp(Math.round((this.width * this.height) / 19000), 38, 68);

      this.particles = Array.from({ length: particleCount }, () => {
        const direction = random() * TAU;
        const velocity = 2.2 + random() * 4.4;

        return {
          x: random() * this.width,
          y: random() * this.height,
          vx: Math.cos(direction) * velocity,
          vy: Math.sin(direction) * velocity,
          size: 0.55 + random() * 1.25,
          alpha: 0.16 + random() * 0.38,
          phase: random() * TAU,
        };
      });
    }

    private readonly renderFrame = (timestamp: number) => {
      this.animationFrame = 0;
      if (!this.shouldAnimate()) return;

      const delta = this.lastFrame ? Math.min((timestamp - this.lastFrame) / 1000, 0.05) : 0;
      this.lastFrame = timestamp;
      this.elapsed += delta;

      if (this.pointer.active && timestamp - this.pointer.lastSeen > 1800) {
        this.pointer.active = false;
      }
      this.pointer.x += (this.pointer.targetX - this.pointer.x) * Math.min(1, delta * 10);
      this.pointer.y += (this.pointer.targetY - this.pointer.y) * Math.min(1, delta * 10);

      this.updateParticles(delta);
      this.drawScene(this.elapsed);
      this.animationFrame = window.requestAnimationFrame(this.renderFrame);
    };

    private updateParticles(delta: number) {
      const interactionRadius = Math.min(150, this.width * 0.16);

      for (const particle of this.particles) {
        const flow = Math.sin(this.elapsed * 0.42 + particle.phase) * 0.32;
        particle.vx += Math.cos(particle.phase) * flow * delta;
        particle.vy += Math.sin(particle.phase * 1.7) * flow * delta;

        if (this.pointer.active) {
          const dx = particle.x - this.pointer.x;
          const dy = particle.y - this.pointer.y;
          const distance = Math.hypot(dx, dy) || 1;

          if (distance < interactionRadius) {
            const influence = 1 - distance / interactionRadius;
            const acceleration = influence * 30 * delta;
            particle.vx += (-dy / distance) * acceleration + (dx / distance) * acceleration * 0.35;
            particle.vy += (dx / distance) * acceleration + (dy / distance) * acceleration * 0.35;
          }
        }

        const speed = Math.hypot(particle.vx, particle.vy);
        if (speed > 14) {
          particle.vx = (particle.vx / speed) * 14;
          particle.vy = (particle.vy / speed) * 14;
        }

        particle.vx *= 1 - delta * 0.035;
        particle.vy *= 1 - delta * 0.035;
        particle.x += particle.vx * delta;
        particle.y += particle.vy * delta;

        const margin = 8;
        if (particle.x < -margin) particle.x = this.width + margin;
        if (particle.x > this.width + margin) particle.x = -margin;
        if (particle.y < -margin) particle.y = this.height + margin;
        if (particle.y > this.height + margin) particle.y = -margin;
      }
    }

    private drawScene(time: number) {
      const context = this.context;
      if (!context || !this.width || !this.height) return;

      context.clearRect(0, 0, this.width, this.height);
      this.drawAtmosphere(context);
      this.drawAmbientParticles(context, time);
      this.drawTaskPaths(context, time);
      this.nodes.forEach((node) => this.drawNode(context, node, time));
    }

    private drawAtmosphere(context: CanvasRenderingContext2D) {
      const cores = this.nodes.filter((node) => node.kind === 'orchestrator');

      for (const node of cores) {
        const radius = Math.min(this.width, this.height) * (this.compact ? 0.34 : 0.28);
        const gradient = context.createRadialGradient(node.x, node.y, 0, node.x, node.y, radius);
        gradient.addColorStop(0, `rgba(${this.palette.core}, ${0.075 * this.palette.glow})`);
        gradient.addColorStop(0.48, `rgba(${this.palette.agent}, ${0.026 * this.palette.glow})`);
        gradient.addColorStop(1, `rgba(${this.palette.core}, 0)`);
        context.fillStyle = gradient;
        context.fillRect(node.x - radius, node.y - radius, radius * 2, radius * 2);
      }
    }

    private drawAmbientParticles(context: CanvasRenderingContext2D, time: number) {
      context.save();

      for (const particle of this.particles) {
        const shimmer = 0.72 + Math.sin(time * 0.75 + particle.phase) * 0.28;
        let proximity = 0;

        if (this.pointer.active) {
          proximity = 1 - clamp(Math.hypot(particle.x - this.pointer.x, particle.y - this.pointer.y) / 125, 0, 1);
        }

        context.beginPath();
        context.fillStyle = `rgba(${this.palette.particle}, ${particle.alpha * shimmer + proximity * 0.3})`;
        context.arc(particle.x, particle.y, particle.size + proximity * 0.75, 0, TAU);
        context.fill();

        if (proximity > 0.18) {
          context.beginPath();
          context.strokeStyle = `rgba(${this.palette.particle}, ${proximity * 0.16})`;
          context.lineWidth = 0.6;
          context.moveTo(particle.x, particle.y);
          context.lineTo(particle.x - particle.vx * 0.75, particle.y - particle.vy * 0.75);
          context.stroke();
        }
      }

      context.restore();
    }

    private drawTaskPaths(context: CanvasRenderingContext2D, time: number) {
      for (const path of this.paths) {
        const fromNode = this.nodes[path.from];
        const toNode = this.nodes[path.to];
        if (!fromNode || !toNode) continue;

        const from = this.nodePosition(fromNode, time);
        const to = this.nodePosition(toNode, time);
        const control = this.curveControl(from, to, path.bend);
        const toolCall = toNode.kind === 'tool';
        const pointerBoost = this.pathPointerInfluence(from, control, to);
        const color = toolCall ? this.palette.tool : this.palette.line;

        context.save();
        context.setLineDash(toolCall ? [2, 7] : [7, 10]);
        context.lineDashOffset = this.reducedMotion ? 0 : -time * (toolCall ? 5 : 3);
        context.beginPath();
        context.moveTo(from.x, from.y);
        context.quadraticCurveTo(control.x, control.y, to.x, to.y);
        context.strokeStyle = `rgba(${color}, ${0.13 + pointerBoost * 0.18})`;
        context.lineWidth = 0.7 + pointerBoost * 0.45;
        context.stroke();
        context.restore();

        const progress = (time * path.speed + path.phase) % 1;
        this.drawTaskPulse(context, from, control, to, progress, color, pointerBoost);

        if (!this.compact && !toolCall) {
          const secondProgress = (progress + 0.56) % 1;
          this.drawTaskPulse(context, from, control, to, secondProgress, color, pointerBoost, 0.58);
        }
      }
    }

    private drawTaskPulse(
      context: CanvasRenderingContext2D,
      from: Point,
      control: Point,
      to: Point,
      progress: number,
      color: string,
      pointerBoost: number,
      opacity = 1
    ) {
      const point = this.quadraticPoint(from, control, to, progress);
      const previous = this.quadraticPoint(from, control, to, Math.max(0, progress - 0.035));
      const edgeFade = Math.sin(progress * Math.PI);
      const alpha = edgeFade * (0.55 + pointerBoost * 0.35) * opacity;

      context.save();
      const gradient = context.createLinearGradient(previous.x, previous.y, point.x, point.y);
      gradient.addColorStop(0, `rgba(${color}, 0)`);
      gradient.addColorStop(1, `rgba(${color}, ${alpha})`);
      context.beginPath();
      context.moveTo(previous.x, previous.y);
      context.lineTo(point.x, point.y);
      context.strokeStyle = gradient;
      context.lineWidth = 1.3 + pointerBoost;
      context.stroke();

      context.shadowColor = `rgba(${color}, ${alpha})`;
      context.shadowBlur = 8 + pointerBoost * 5;
      context.beginPath();
      context.fillStyle = `rgba(${color}, ${alpha})`;
      context.arc(point.x, point.y, 1.35 + pointerBoost * 0.65, 0, TAU);
      context.fill();
      context.restore();
    }

    private drawNode(context: CanvasRenderingContext2D, node: SceneNode, time: number) {
      const position = this.nodePosition(node, time);
      const pointerDistance = this.pointer.active
        ? Math.hypot(position.x - this.pointer.x, position.y - this.pointer.y)
        : Number.POSITIVE_INFINITY;
      const focus = 1 - clamp(pointerDistance / 150, 0, 1);
      const breathe = 1 + Math.sin(time * 0.82 + node.phase) * 0.035;
      const size = node.size * breathe * (1 + focus * 0.08);

      if (node.kind === 'orchestrator') {
        this.drawOrchestrator(context, position, size, time, node.phase, focus);
      } else if (node.kind === 'tool') {
        this.drawTool(context, position, size, time, node.phase, focus);
      } else {
        this.drawAgent(context, position, size, time, node.phase, focus);
      }
    }

    private drawOrchestrator(
      context: CanvasRenderingContext2D,
      position: Point,
      size: number,
      time: number,
      phase: number,
      focus: number
    ) {
      context.save();
      context.translate(position.x, position.y);
      const color = this.palette.core;
      const halo = context.createRadialGradient(0, 0, size * 0.15, 0, 0, size * 2.7);
      halo.addColorStop(0, `rgba(${color}, ${0.2 + focus * 0.09})`);
      halo.addColorStop(0.35, `rgba(${color}, ${0.07 * this.palette.glow})`);
      halo.addColorStop(1, `rgba(${color}, 0)`);
      context.fillStyle = halo;
      context.fillRect(-size * 2.7, -size * 2.7, size * 5.4, size * 5.4);

      context.lineWidth = 0.8 + focus * 0.5;
      context.strokeStyle = `rgba(${color}, ${0.32 + focus * 0.28})`;
      context.setLineDash([size * 0.48, size * 0.2]);
      context.lineDashOffset = this.reducedMotion ? 0 : -time * 4.5;
      context.beginPath();
      context.arc(0, 0, size * 1.36, phase, phase + TAU);
      context.stroke();

      context.setLineDash([]);
      context.lineWidth = 0.75;
      context.strokeStyle = `rgba(${this.palette.agent}, ${0.26 + focus * 0.2})`;
      context.beginPath();
      context.arc(0, 0, size * 0.88, 0, TAU);
      context.stroke();

      const core = context.createRadialGradient(-size * 0.18, -size * 0.2, 0, 0, 0, size * 0.55);
      core.addColorStop(0, `rgba(${this.palette.surface}, 0.96)`);
      core.addColorStop(0.35, `rgba(${color}, 0.9)`);
      core.addColorStop(1, `rgba(${this.palette.agent}, 0.3)`);
      context.shadowColor = `rgba(${color}, ${0.5 + focus * 0.2})`;
      context.shadowBlur = 11 + focus * 7;
      context.beginPath();
      context.fillStyle = core;
      context.arc(0, 0, size * 0.35, 0, TAU);
      context.fill();
      context.shadowBlur = 0;

      for (let index = 0; index < 3; index += 1) {
        const angle = phase + index * (TAU / 3) + (this.reducedMotion ? 0 : time * 0.19);
        const orbit = size * 1.36;
        context.beginPath();
        context.fillStyle = `rgba(${index === 1 ? this.palette.tool : color}, ${0.72 + focus * 0.18})`;
        context.arc(Math.cos(angle) * orbit, Math.sin(angle) * orbit, size * 0.105, 0, TAU);
        context.fill();
      }

      context.restore();
    }

    private drawAgent(
      context: CanvasRenderingContext2D,
      position: Point,
      size: number,
      time: number,
      phase: number,
      focus: number
    ) {
      context.save();
      context.translate(position.x, position.y);
      const color = this.palette.agent;

      context.strokeStyle = `rgba(${color}, ${0.28 + focus * 0.28})`;
      context.lineWidth = 0.75 + focus * 0.4;
      context.beginPath();
      context.arc(0, 0, size, 0, TAU);
      context.stroke();

      const rotation = phase + (this.reducedMotion ? 0 : time * 0.24);
      context.strokeStyle = `rgba(${this.palette.core}, ${0.5 + focus * 0.28})`;
      context.lineWidth = 1.25;
      context.beginPath();
      context.arc(0, 0, size * 1.34, rotation, rotation + Math.PI * 0.72);
      context.stroke();

      context.beginPath();
      context.fillStyle = `rgba(${color}, ${0.5 + focus * 0.34})`;
      context.arc(0, 0, size * 0.25, 0, TAU);
      context.fill();

      context.beginPath();
      context.fillStyle = `rgba(${this.palette.core}, ${0.72 + focus * 0.2})`;
      context.arc(Math.cos(rotation) * size * 1.34, Math.sin(rotation) * size * 1.34, size * 0.12, 0, TAU);
      context.fill();

      context.restore();
    }

    private drawTool(
      context: CanvasRenderingContext2D,
      position: Point,
      size: number,
      time: number,
      phase: number,
      focus: number
    ) {
      context.save();
      context.translate(position.x, position.y);
      context.rotate(Math.sin(time * 0.21 + phase) * 0.06);
      const color = this.palette.tool;

      context.shadowColor = `rgba(${color}, ${0.25 + focus * 0.3})`;
      context.shadowBlur = 7 + focus * 6;
      context.strokeStyle = `rgba(${color}, ${0.45 + focus * 0.34})`;
      context.lineWidth = 0.9 + focus * 0.45;
      this.roundedRectangle(context, -size, -size, size * 2, size * 2, size * 0.38);
      context.stroke();
      context.shadowBlur = 0;

      const inset = size * 0.48;
      const length = size * 0.29;
      context.strokeStyle = `rgba(${color}, ${0.62 + focus * 0.24})`;
      context.lineWidth = 0.75;
      for (const x of [-1, 1]) {
        for (const y of [-1, 1]) {
          context.beginPath();
          context.moveTo(x * inset, y * (inset - length));
          context.lineTo(x * inset, y * inset);
          context.lineTo(x * (inset - length), y * inset);
          context.stroke();
        }
      }

      context.beginPath();
      context.fillStyle = `rgba(${this.palette.core}, ${0.58 + focus * 0.3})`;
      context.arc(0, 0, size * 0.17, 0, TAU);
      context.fill();
      context.restore();
    }

    private roundedRectangle(
      context: CanvasRenderingContext2D,
      x: number,
      y: number,
      width: number,
      height: number,
      radius: number
    ) {
      const corner = Math.min(radius, width / 2, height / 2);
      context.beginPath();
      context.moveTo(x + corner, y);
      context.lineTo(x + width - corner, y);
      context.quadraticCurveTo(x + width, y, x + width, y + corner);
      context.lineTo(x + width, y + height - corner);
      context.quadraticCurveTo(x + width, y + height, x + width - corner, y + height);
      context.lineTo(x + corner, y + height);
      context.quadraticCurveTo(x, y + height, x, y + height - corner);
      context.lineTo(x, y + corner);
      context.quadraticCurveTo(x, y, x + corner, y);
      context.closePath();
    }

    private nodePosition(node: SceneNode, time: number): Point {
      if (this.reducedMotion) return { x: node.x, y: node.y };

      const drift = node.kind === 'orchestrator' ? 1.4 : node.kind === 'tool' ? 1.8 : 2.6;
      return {
        x: node.x + Math.cos(time * 0.17 + node.phase) * drift,
        y: node.y + Math.sin(time * 0.21 + node.phase * 1.3) * drift,
      };
    }

    private curveControl(from: Point, to: Point, bend: number): Point {
      const dx = to.x - from.x;
      const dy = to.y - from.y;
      const distance = Math.hypot(dx, dy);
      const normalX = distance ? -dy / distance : 0;
      const normalY = distance ? dx / distance : 0;

      return {
        x: (from.x + to.x) / 2 + normalX * distance * bend,
        y: (from.y + to.y) / 2 + normalY * distance * bend,
      };
    }

    private quadraticPoint(from: Point, control: Point, to: Point, progress: number): Point {
      const inverse = 1 - progress;
      return {
        x: inverse * inverse * from.x + 2 * inverse * progress * control.x + progress * progress * to.x,
        y: inverse * inverse * from.y + 2 * inverse * progress * control.y + progress * progress * to.y,
      };
    }

    private pathPointerInfluence(from: Point, control: Point, to: Point) {
      if (!this.pointer.active) return 0;

      let nearest = Number.POSITIVE_INFINITY;
      for (let index = 1; index < 7; index += 1) {
        const point = this.quadraticPoint(from, control, to, index / 7);
        nearest = Math.min(nearest, Math.hypot(point.x - this.pointer.x, point.y - this.pointer.y));
      }
      return 1 - clamp(nearest / 100, 0, 1);
    }

    private shouldAnimate() {
      return this.initialized && !this.reducedMotion && this.inView && this.pageVisible && !this.swapping;
    }

    private syncAnimation() {
      if (this.shouldAnimate()) {
        if (!this.animationFrame) {
          this.lastFrame = performance.now();
          this.animationFrame = window.requestAnimationFrame(this.renderFrame);
        }
        return;
      }

      this.stopAnimation();
      this.drawScene(this.elapsed);
    }

    private stopAnimation() {
      if (this.animationFrame) {
        window.cancelAnimationFrame(this.animationFrame);
        this.animationFrame = 0;
      }
      this.lastFrame = 0;
    }

    private destroy() {
      this.stopAnimation();
      if (this.resizeFrame) {
        window.cancelAnimationFrame(this.resizeFrame);
        this.resizeFrame = 0;
      }

      this.abortController?.abort();
      this.resizeObserver?.disconnect();
      this.intersectionObserver?.disconnect();
      this.themeObserver?.disconnect();
      this.abortController = null;
      this.resizeObserver = null;
      this.intersectionObserver = null;
      this.themeObserver = null;
      this.motionQuery = null;
      this.compactQuery = null;
      this.canvas = null;
      this.context = null;
      this.initialized = false;
    }
  }

  if (!customElements.get('future-particles')) {
    customElements.define('future-particles', FutureParticles);
  }
</script>

