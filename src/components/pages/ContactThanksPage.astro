---
import Layout from '~/layouts/PageLayout.astro';
import type { SiteLocale } from '~/navigation';

export interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const isChinese = locale === 'zh';
const copy = isChinese
  ? {
      title: '提交成功',
      description: '感谢你的留言，我们会尽快回复。',
      heading: '已收到你的留言',
      body: '感谢联系玄盾开发者团队，我们会尽快通过你填写的邮箱回复。',
      home: '返回首页',
      again: '重新填写',
      email: '如果你希望立即联系，直接发送邮件也许会更快：',
    }
  : {
      title: 'Message sent',
      description: 'Thank you for your message. We will respond soon.',
      heading: 'We received your message',
      body: 'Thank you for contacting the XuanDun Developer Team. We will reply to the email address you provided.',
      home: 'Back to home',
      again: 'Send another message',
      email: 'For a faster response, you can also email us directly:',
    };
---

<Layout metadata={{ title: copy.title, description: copy.description }} {locale}>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 md:py-16">
    <div
      class="rounded-2xl border border-slate-200 bg-white/80 p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"
    >
      <h1 class="text-2xl font-bold tracking-tight md:text-3xl">{copy.heading}</h1>
      <p class="mt-3 text-muted">{copy.body}</p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a class="btn-primary" href={isChinese ? '/zh' : '/'}>{copy.home}</a>
        <a class="btn-secondary" href={isChinese ? '/zh/contact' : '/contact'}>{copy.again}</a>
      </div>
      <p class="mt-6 text-sm text-muted">
        {copy.email}
        <a class="underline" href="mailto:neflibatafeng@gmail.com">neflibatafeng@gmail.com</a>
      </p>
    </div>
  </section>
</Layout>
