---
import { SITE } from 'astrowind:config';
import Image from '~/components/common/Image.astro';
import logoImg from '~/assets/images/XuanDun.png';

export interface Props {
  name?: string;
}

const { name = SITE?.name } = Astro.props;
---

<span
  class="ml-2 flex self-center items-center whitespace-nowrap text-xl font-bold text-gray-900 dark:text-white rtl:ml-0 rtl:mr-2"
>
  <Image src={logoImg} alt={name} class="w-8 h-8 mr-2 rounded-full" />
  <span class="hidden sm:inline">{name}</span>
</span>
